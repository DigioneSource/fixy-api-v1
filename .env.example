# =============================================================================
# TAYZEN API — biến môi trường cho docker-compose.yml
# Chép thành .env (cùng thư mục docker-compose.yml) rồi điền giá trị:
#   cp .env.example .env && chmod 600 .env
# KHÔNG commit .env. Mọi giá trị dưới đây là để trống hoặc ví dụ giả.
#
# Quy ước: tên khoá ứng dụng dạng Section__Key (hai dấu gạch dưới) = Section:Key trong appsettings.
# Mật khẩu: chỉ dùng chữ + số (tránh ; ' " $ và khoảng trắng vì chúng phá chuỗi kết nối).
# Sinh mật khẩu mạnh:  openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 32; echo
# =============================================================================

# ----------------------------------------------------------------- Hạ tầng
# Tag image khi build (tuỳ chọn), ví dụ ngày deploy
TAYZEN_TAG=latest

# Mật khẩu tài khoản sa của SQL Server. BẮT BUỘC. ≥ 8 ký tự, có chữ hoa + chữ thường + số.
MSSQL_SA_PASSWORD=
# Giới hạn RAM SQL Server (MB). VPS 4 GB: 1536. VPS 8 GB: 3072 (Express chỉ dùng tối đa ~1,4 GB buffer pool).
MSSQL_MEMORY_LIMIT_MB=1536
# Tên CSDL
DB_NAME=TAYZEN
# Login hạn chế quyền mà API dùng (chỉ đọc/ghi dữ liệu). deploy/migrate.sh tự tạo.
DB_APP_USER=tayzen_app
# Mật khẩu của login trên. BẮT BUỘC. Cùng quy tắc độ mạnh như sa.
DB_APP_PASSWORD=

# Mật khẩu Redis. BẮT BUỘC.
REDIS_PASSWORD=
# Tiền tố khoá trong Redis (tuỳ chọn)
RedisSettings__InstanceName=tayzen:

# Token của Cloudflare Tunnel (Zero Trust > Networks > Tunnels > tạo tunnel > Docker). BẮT BUỘC.
CLOUDFLARE_TUNNEL_TOKEN=
# Phiên bản image cloudflared (tuỳ chọn, nên ghim khi đã chạy ổn, ví dụ 2025.1.0)
CLOUDFLARED_TAG=latest

# Số ngày giữ bản sao lưu (deploy/backup.sh)
BACKUP_KEEP_DAYS=7
# (Tuỳ chọn) đích rclone để chép bản sao lưu ra ngoài VPS, ví dụ r2:tayzen-backup
RCLONE_REMOTE=

# Chỉ dùng 1 lần cho deploy/set-admin-password.sh. XOÁ ADMIN_PASSWORD sau khi chạy xong.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ----------------------------------------------------------------- JWT (BẮT BUỘC)
# Khoá ký token, chuỗi ngẫu nhiên ≥ 32 ký tự (HMAC-SHA256). Đổi khoá = mọi người bị đăng xuất.
JwtSettings__Secret=
# Bên phát hành và đối tượng token, ví dụ https://api.tayzen.vn
JwtSettings__Issuer=https://api.example.vn
JwtSettings__Audience=https://api.example.vn
# Hạn access token (phút) và refresh token (ngày). Phải là số, không để trống.
JwtSettings__AccessTokenExpirationMinutes=60
JwtSettings__RefreshTokenExpirationDays=30

# ----------------------------------------------------------------- Lưu ảnh
# Local = lưu ở volume api-uploads trên VPS, phục vụ qua https://<api>/media/<file>
# AzureBlob = giữ Azure Blob như cũ (cần BlobSettings__*)
Storage__Provider=Local
# Địa chỉ công khai của API, dùng để tạo URL ảnh. BẮT BUỘC khi Provider=Local.
Storage__Local__PublicBaseUrl=https://api.example.vn
# Azure Blob (chỉ khi Storage__Provider=AzureBlob)
BlobSettings__ConnectionString=
BlobSettings__ContainerName=
# Cloudinary: có khai báo trong mã nhưng HIỆN KHÔNG được dùng ở đâu. Để trống.
CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=

# ----------------------------------------------------------------- Đăng nhập Google / Facebook
# OAuth Client ID (Google Cloud Console > Credentials). Để trống = tắt đăng nhập Google.
GoogleSettings__WebClientId=
GoogleSettings__IosClientId=
# Facebook App (developers.facebook.com). Để trống = tắt đăng nhập Facebook.
FacebookSettings__AppId=
FacebookSettings__AppSecret=

# ----------------------------------------------------------------- Thanh toán
# MoMo (business.momo.vn). BaseUrl thử nghiệm: https://test-payment.momo.vn
MoMoSettings__PartnerCode=
MoMoSettings__AccessKey=
MoMoSettings__SecretKey=
MoMoSettings__BaseUrl=
MoMoSettings__ReturnUrl=
# URL MoMo gọi về (IPN) — phải là địa chỉ công khai của API
MoMoSettings__NotifyUrl=

# VNPay (sandbox.vnpayment.vn). BaseUrl sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VnPaySettings__TmnCode=
VnPaySettings__HashSecret=
VnPaySettings__BaseUrl=
VnPaySettings__ReturnUrl=

# payOS (my.payos.vn). LƯU Ý tên section viết đúng là "PayOSSetings" (thiếu chữ t) như trong mã.
PayOSSetings__ClientId=
PayOSSetings__ApiKey=
PayOSSetings__ChecksumKey=
PayOSSetings__ReturnUrl=
PayOSSetings__CancelUrl=

# SePay: token xác thực webhook chuyển tiền chi trả cho KTV. Để trống = KHÔNG kiểm tra token (nguy hiểm).
SePay__WebhookToken=

# ----------------------------------------------------------------- Email OTP (SMTP)
# Ví dụ Gmail: smtp.gmail.com / 587 / true / mật khẩu ứng dụng
SmtpSettings__Host=
SmtpSettings__Port=587
SmtpSettings__EnableSsl=true
SmtpSettings__Username=
SmtpSettings__Password=
# Địa chỉ người gửi, ví dụ no-reply@example.vn
SmtpSettings__From=

# ----------------------------------------------------------------- SMS OTP
# UseMock=true: không gửi SMS thật (chỉ ghi log). Production phải đặt false + cấu hình nhà mạng.
SmsSettings__UseMock=true
# Provider: SpeedSMS | Twilio | tên khác = gọi HTTP chung tới SmsSettings__BaseUrl
SmsSettings__Provider=Mock
SmsSettings__ApiKey=
SmsSettings__ApiSecret=
SmsSettings__SenderId=FIXY
SmsSettings__BaseUrl=
SmsSettings__TimeoutSeconds=10

# ----------------------------------------------------------------- Khác
# Số phút KTV có để nhận một lời mời đơn
WorkerMatchingSettings__OfferTimeoutMinutes=15
# Khoá API Goong (goong.io) để đổi địa chỉ -> toạ độ. Để trống = không geocode.
GOONG_API_KEY=
# Firebase Cloud Messaging (đẩy thông báo): đặt file service account vào ./secrets/firebase.json
# rồi điền đường dẫn trong container dưới đây. Để trống = tắt push.
Firebase__CredentialJsonPath=
# Firebase__CredentialJsonPath=/run/secrets/tayzen/firebase.json
# Domain web được gọi API từ trình duyệt (CORS), ngoài localhost:3000 và fixy-fe-v1.vercel.app có sẵn
Cors__AllowedOrigins__0=
Cors__AllowedOrigins__1=
